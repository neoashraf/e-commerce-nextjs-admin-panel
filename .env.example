# ─────────────────────────────────────────────────────────────────────────────
# Environment config. Next.js auto-selects the file by NODE_ENV:
#   next dev                   → .env.development   (shared dev backend server)
#   next build && next start   → .env.production    (production backend)
# .env.local (gitignored) overrides either, for personal/local-only changes.
# Precedence: .env.local > .env.[development|production] > .env
#
# .env.development and .env.production are committed (shared with the team).
# Copy this file to .env.local only if you need a personal override.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend REST API (NestJS). Includes the /api/v1 prefix.
# See docs/srs/00-overview.md §7 — base path /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
